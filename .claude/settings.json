{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "allowPty": true,
    "excludedCommands": [
      "agent-bell *",
      "nats *",
      "/Users/ac/_sync/dev/infra/tools/relay-drain *",
      "/Users/ac/_sync/dev/infra/tools/relay-outcome *",
      "/Users/ac/_sync/dev/infra/tools/relay-send *",
      "/Users/ac/_sync/dev/CONTEXT/SKILLS/gestore/asks.py *",
      "/Users/ac/_sync/dev/CONTEXT/SKILLS/gestore/reconcile.py *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/dev/worktrees/herdr",
        "~/.cargo",
        "~/.rustup",
        "~/.cache/zig",
        "~/.cache/uv",
        "/tmp",
        "/private/tmp",
        "~/.config/herdr-dev",
        "~/.local/state/agent-handover/herdr-helper",
        "~/.local/state/herdr-beta-local",
        "~/.local/state/herdr-sync",
        "~/.local/state/model-routing",
        "~/.local/state/agent-bell",
        "~/_sync/dev/.agent-state/reconcile",
        "~/.Trash"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowAllUnixSockets": true,
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.config/herdr/herdr-client.sock",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "raw.githubusercontent.com",
        "gitea.cat-bluegill.ts.net",
        "asks.cat-bluegill.ts.net",
        "index.crates.io",
        "static.crates.io",
        "crates.io",
        "deps.files.ghostty.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ac/_sync/dev/herdr/.claude/sandbox-pilot/log-violation.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ac/_sync/dev/herdr/.claude/sandbox-pilot/log-violation.sh"
          }
        ]
      }
    ]
  }
}
